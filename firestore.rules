rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this email list in sync with ADMIN_EMAILS in admin/js/admin-auth.mjs
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'damzyeazy@gmail.com';
    }

    // Private named Circuit Studio projects; public visitors cannot read or write these records.
    match /circuitStudioProjects/{projectId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /circuitComponents/{componentId} {
      // Public clients may list only published components; the query must
      // include status == 'published'. Admins can read drafts and manage all.
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Public checkout. The document ID must equal its tracking code, and the
      // server-controlled fields must start in their initial state so a crafted
      // request cannot create an order that is already "delivered" or "paid".
      allow create: if request.resource.data.keys().hasAll(['items', 'customerName', 'phone', 'total', 'trackingCode', 'status', 'createdAt'])
                    && request.resource.data.keys().size() <= 25
                    && orderId.matches('EZ-[A-Z0-9]{6,10}')
                    && request.resource.data.trackingCode == orderId
                    && request.resource.data.status == 'new'
                    && request.resource.data.inventoryApplied == false
                    && request.resource.data.get('inventoryReturned', false) == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total < 100000000
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.customerName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 6
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.get('address', '') is string
                    && request.resource.data.get('address', '').size() <= 500;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();

      match /payments/{paymentId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroes/{heroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      // Scheduled projects remain private. An authenticated admin session
      // promotes due projects to "published"; public visitors can then read them.
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Public visitors can read approved reviews only. Admins can manage all submissions.
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if isAdmin() || (
                    request.resource.data.keys().hasAll(['name', 'text', 'approved'])
                    && request.resource.data.keys().size() <= 15
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1500
                    && request.resource.data.approved == false
                    );
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'need'])
                    && request.resource.data.keys().size() <= 12
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 6
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.need is string
                    && request.resource.data.need.size() > 0
                    && request.resource.data.need.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryPersonnel/{personId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryTypes/{typeId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryCheckpoints/{checkpointId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Quotations are private admin records, deliberately isolated from orders and inventory.
    match /quotations/{quotationId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Reusable quotation-only catalogue; never linked to product stock.
    match /quotationCatalogue/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Private School STEM records and pricing. No public reads or writes.
    match /schoolStemMeetings/{meetingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /schoolStemPricing/{configId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Private out-of-school Technical Training records and price catalogue.
    match /technicalTrainingLeads/{leadId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /technicalTrainingPricing/{configId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      // Public `get` only (never `list`): the tracking page fetches one
      // specific delivery by ID, which it can only learn from the order's
      // own `deliveryId` field after looking that order up by tracking code —
      // same one-way trust model already used for `orders` below. `list`
      // stays admin-only so the whole collection can't be enumerated.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
  }
}
