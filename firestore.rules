rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['items', 'customerName', 'phone', 'total'])
                    && request.resource.data.total is number
                    && request.resource.data.items is list;
      // Anyone who already has the exact tracking code can fetch that one order (Track Order page).
      // Nobody can browse/query the full order list without being the admin.
      allow get: if true;
      allow list: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /heroes/{heroId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'text'])
                    && request.resource.data.name is string
                    && request.resource.data.text is string;
      allow update, delete: if request.auth != null;
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'need'])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
