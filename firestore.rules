rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'damzyeazy@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['items', 'customerName', 'phone', 'total'])
                    && request.resource.data.total is number
                    && request.resource.data.items is list;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();

      match /payments/{paymentId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroes/{heroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      // Scheduled projects remain private. An authenticated admin session
      // promotes due projects to "published"; public visitors can then read them.
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Public visitors can read approved reviews only. Admins can manage all submissions.
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if isAdmin() || (
                    request.resource.data.keys().hasAll(['name', 'text', 'approved'])
                    && request.resource.data.name is string
                    && request.resource.data.text is string
                    && request.resource.data.approved == false
                    );
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'need'])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryPersonnel/{personId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryTypes/{typeId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryCheckpoints/{checkpointId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Quotations are private admin records, deliberately isolated from orders and inventory.
    match /quotations/{quotationId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Reusable quotation-only catalogue; never linked to product stock.
    match /quotationCatalogue/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      // Public `get` only (never `list`): the tracking page fetches one
      // specific delivery by ID, which it can only learn from the order's
      // own `deliveryId` field after looking that order up by tracking code —
      // same one-way trust model already used for `orders` below. `list`
      // stays admin-only so the whole collection can't be enumerated.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
  }
}